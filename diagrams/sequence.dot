digraph G {graph [label="Sequence: Create a Sticky Note",labelloc=t,fontsize=20,rankdir=LR];node [shape=box,fontname="Arial"]; user [label="User / Browser"];url [label="Django URL Router"];view [label="note_create View"];form [label="NoteForm"];db [label="Note Model / DB"];user -> url [label="POST title, content"];url -> view [label="Route request"];view -> form [label="Validate input"];form -> view [label="Valid form"];view -> db [label="Save note"];db -> view [label="Saved"];view -> user [label="Redirect to note list"]; }