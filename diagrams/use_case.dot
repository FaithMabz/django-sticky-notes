digraph G {graph [label="Sticky Notes: Use Case Diagram",labelloc=t,fontsize=20,rankdir=LR];node [fontname="Arial"]; user [label="User",shape=box]; subgraph cluster_app {label="Sticky Notes Application";style=rounded; list [label="List notes",shape=ellipse];view [label="View note",shape=ellipse];create [label="Create note",shape=ellipse];edit [label="Edit note",shape=ellipse];delete [label="Delete note",shape=ellipse];} user -> {list view create edit delete} [dir=none];}