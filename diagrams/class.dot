digraph G {graph [label="Sticky Notes: Class Diagram",labelloc=t,fontsize=20,rankdir=LR];node [shape=record,fontname="Arial"];Note [label="{Note (models.Model)|title: CharField (200)\lcontent: TextField\lcreated_at: DateTimeField\l|__str__(): str\l}"];Form [label="{NoteForm (forms.ModelForm)|Meta.model = Note\lMeta.fields = [title, content]\l|is_valid()\lsave()\l}"];View [label="{Views|note_list(request)\lnote_detail(request, pk)\lnote_create(request)\lnote_update(request, pk)\lnote_delete(request, pk)\l}"];Form -> Note [label="validates / saves"];View -> Form [label="uses"];View -> Note [label="queries / deletes"]; }